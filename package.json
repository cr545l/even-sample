{
  "name": "even-g2-counter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "simulator": "evenhub-simulator http://localhost:5173",
    "qr": "evenhub qr",
    "pack": "npm run build && evenhub pack app.json dist --sdk-ver 0.0.16 -o even-g2-sensors.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "~5.9.3",
    "vite": "^6.4.3"
  }
}
